<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash from the windowSplashScreen* attributes
         and ignores windowBackground, so without these the system falls back to
         the launcher icon — a black square on a black background, which reads as
         a blank screen. launch_glyph is the bare glyph, sized to 66% of its
         canvas so it survives the system's circular mask and lands close to the
         size the Flutter splash draws it at.

         The version qualifier outranks the night qualifier, so this file also
         replaces values-night's LaunchTheme on API 31+; the launch window is
         painted black either way, and NormalTheme (which the Flutter UI
         actually uses) is untouched. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_glyph</item>
    </style>
</resources>
